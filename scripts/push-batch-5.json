[{"path":"templates/slide.html","content":"<!DOCTYPE html>\n<html lang=\"en-GB\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Protect Line — slide template</title>\n  <link rel=\"stylesheet\" href=\"../colors_and_type.css\">\n  <link rel=\"stylesheet\" href=\"../components/components.css\">\n  <style>\n    .slide {\n      width: 100%;\n      max-width: 960px;\n      aspect-ratio: 16/9;\n      margin: var(--spacing-xhg) auto;\n      border-radius: var(--radius-md);\n      overflow: hidden;\n      display: flex;\n      flex-direction: column;\n      justify-content: center;\n      padding: var(--spacing-xxhg);\n      position: relative;\n    }\n    .slide--navy { background: var(--color-navy); color: var(--color-white); }\n    .slide--fair-blue { background: var(--color-fair-blue); color: var(--color-navy); }\n    .slide__logo { position: absolute; top: var(--spacing-lg); left: var(--spacing-lg); height: 32px; }\n    .slide__hugo { position: absolute; bottom: var(--spacing-lg); right: var(--spacing-lg); width: 48px; }\n  </style>\n</head>\n<body style=\"background:#eee;padding:var(--spacing-xhg)\">\n  <h1 class=\"pl-h2\" style=\"text-align:center;margin-bottom:var(--spacing-xhg)\">Slide templates (16:9)</h1>\n\n  <!-- Slide 1: Title -->\n  <div class=\"slide slide--navy\">\n    <img src=\"../assets/logo-white-pink.svg\" alt=\"\" class=\"slide__logo\">\n    <p class=\"pl-subheading-caps\" style=\"color:var(--color-light-pink)\">[Eyebrow]</p>\n    <h1 class=\"pl-display\" style=\"color:var(--color-white);max-width:700px\">[Slide title in sentence case]</h1>\n    <p class=\"pl-body\" style=\"color:var(--color-light-pink);margin-top:var(--spacing-md);max-width:600px\">[Subtitle — one line, warm and clear]</p>\n    <img src=\"../assets/hugo.svg\" alt=\"\" class=\"slide__hugo\">\n  </div>\n\n  <!-- Slide 2: Content -->\n  <div class=\"slide slide--fair-blue\">\n    <img src=\"../assets/logo-navy.svg\" alt=\"\" class=\"slide__logo\">\n    <span class=\"pl-section-heading\" style=\"margin-bottom:var(--spacing-lg)\">[Section title]</span>\n    <ul class=\"pl-body\" style=\"max-width:700px;padding-left:var(--spacing-lg)\">\n      <li>[Key point 1 — sentence case]</li>\n      <li>[Key point 2]</li>\n      <li>[Key point 3]</li>\n    </ul>\n  </div>\n\n  <!-- Slide 3: Quote -->\n  <div class=\"slide slide--navy\" style=\"text-align:center\">\n    <img src=\"../assets/logo-white-pink.svg\" alt=\"\" class=\"slide__logo\">\n    <p class=\"pl-quote\" style=\"color:var(--color-white);max-width:700px;margin:0 auto\">\"[Customer quote or key message]\"</p>\n    <p class=\"pl-body\" style=\"color:var(--color-light-pink);margin-top:var(--spacing-lg)\">— [Attribution]</p>\n  </div>\n\n  <!-- Slide 4: CTA -->\n  <div class=\"slide slide--navy\" style=\"text-align:center\">\n    <img src=\"../assets/logo-white-pink.svg\" alt=\"\" class=\"slide__logo\">\n    <h2 class=\"pl-h1\" style=\"color:var(--color-white)\">[CTA headline]</h2>\n    <a href=\"#\" class=\"pl-btn pl-btn-primary\" style=\"margin-top:var(--spacing-lg)\">Get a quote</a>\n    <p class=\"pl-body\" style=\"color:var(--color-light-pink);margin-top:var(--spacing-md)\">protectline.co.uk</p>\n  </div>\n</body>\n</html>\n"}]