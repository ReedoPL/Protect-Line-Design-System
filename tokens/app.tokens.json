          "4": { "$value": "{color.dark-blue.400}" },
          "5": { "$value": "{color.dark-blue.500}" },
          "6": { "$value": "{color.navy}" },
          "$description": "Sequential, low to high. Replaces the generated FAIR→NAVY heatmap steps."
        },
        "seq-pink": {
          "1": { "$value": "{color.fair-pink}" },
          "2": { "$value": "{color.light-pink}" },
          "3": { "$value": "{color.mid-pink}" },
