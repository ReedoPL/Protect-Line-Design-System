          "5": { "$value": "{color.pink.700}" },
          "6": { "$value": "{color.pink.900}" },
          "$description": "Sequential, low to high."
        },
        "div": {
          "1": { "$value": "{color.dark-blue.500}" },
          "2": { "$value": "{color.dark-blue.400}" },
          "3": { "$value": "{color.mid-blue}" },
