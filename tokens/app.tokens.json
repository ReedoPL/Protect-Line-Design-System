          "neutral": {
            "bg": { "$value": "{color.dark-blue.100}" },
            "border": { "$value": "{color.dark-blue.200}" },
            "fg": { "$value": "{color.dark-blue.500}" },
            "solid": { "$value": "{color.dark-blue.400}" },
