  "font": {
    "mono": {
      "$type": "fontFamily",
      "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"],
      "$description": "App layer addition (GUI2-03), not in the Figma foundations — needs brand approval. Monospace for ids, codes and aligned figures. Measured against Poppins in Chromium: the same x-height at the same size (55% of the em), caps and figures 4% taller (so figures are set at 0.96em), digits within 5% of Poppins' width, and 0/O and 1/l/I are unambiguous. Needed because the Google Fonts build of Poppins has no tabular figures: font-variant-numeric: tabular-nums does nothing to it."
    }
  },
  "font-weight": {
    "medium": {
      "$type": "fontWeight",
      "$value": 500,
      "$description": "App layer addition (GUI2-03), not in the Figma foundations — needs brand approval. Poppins Medium for app labels, table headers and tabs — bold (700) is too heavy at 12–14px."
    }
  },
